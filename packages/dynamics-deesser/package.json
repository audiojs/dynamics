{
  "name": "@audio/dynamics-deesser",
  "version": "0.4.0",
  "description": "De-esser: the sibilance band's level over the voice body's drives a cut held within a range, read 5 ms ahead, on the band over 3.5 kHz (linear phase), a band, or broadband; the same at any recording level",
  "type": "module",
  "sideEffects": false,
  "main": "deesser.js",
  "exports": {
    ".": "./deesser.js",
    "./package.json": "./package.json",
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    }
  },
  "files": [
    "deesser.js",
    "audio.js",
    "util.js",
    "audio.d.ts",
    "deesser.d.ts"
  ],
  "dependencies": {
    "@audio/dynamics-compressor": "^0.2.0",
    "@audio/biquad": "^1.1.0"
  },
  "keywords": [
    "audio",
    "dsp",
    "dynamics",
    "deesser"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/dynamics.git",
    "directory": "packages/dynamics-deesser"
  },
  "homepage": "https://github.com/audiojs/dynamics/tree/main/packages/dynamics-deesser",
  "bugs": {
    "url": "https://github.com/audiojs/dynamics/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./deesser.d.ts",
  "audio": "./audio.js",
  "funding": "https://github.com/sponsors/audiojs"
}
