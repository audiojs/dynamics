{
  "name": "@audio/dynamics",
  "version": "0.6.0",
  "type": "module",
  "types": "index.d.ts",
  "description": "Compressor, limiter, gate",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./members/*.d.ts",
      "default": "./members/*.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "members/"
  ],
  "scripts": {
    "test": "node test.js",
    "test:all": "npm test --workspaces --if-present && npm test",
    "publish:all": "node ../compile/tools/tested.js && npm publish --workspaces && npm publish",
    "members": "node scripts/members.js",
    "prepublishOnly": "node ../compile/tools/tested.js && node scripts/members.js --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/dynamics.git"
  },
  "keywords": [
    "dynamics",
    "compressor",
    "limiter",
    "gate",
    "expander",
    "deesser",
    "ducker",
    "softclip",
    "compand",
    "sidechain",
    "audio",
    "audiojs",
    "dsp",
    "transient-shaper"
  ],
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/audiojs/dynamics/issues"
  },
  "homepage": "https://github.com/audiojs/dynamics#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "tst": "^9.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "index.js",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@audio/dynamics-envelope": "^0.1.4",
    "@audio/dynamics-compressor": "^0.4.0",
    "@audio/dynamics-limiter": "^0.3.0",
    "@audio/dynamics-gate": "^0.2.0",
    "@audio/dynamics-expander": "^0.3.0",
    "@audio/dynamics-deesser": "^0.5.0",
    "@audio/dynamics-ducker": "^0.2.0",
    "@audio/dynamics-softclip": "^0.3.0",
    "@audio/dynamics-compand": "^0.2.0",
    "@audio/dynamics-transient-shaper": "^0.2.0",
    "@audio/dynamics-multiband": "^0.5.0",
    "@audio/dynamics-opto": "^0.3.0",
    "@audio/dynamics-fet": "^0.3.0",
    "@audio/dynamics-vca": "^0.3.0",
    "@audio/dynamics-varimu": "^0.3.0",
    "@audio/dynamics-leveler": "^0.2.2",
    "@audio/dynamics-unlimit": "^0.2.0"
  },
  "funding": "https://github.com/sponsors/audiojs"
}
